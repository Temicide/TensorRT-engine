#!/usr/bin/env python3
import argparse
import ctypes
import json
import math
import os
import sys
from pathlib import Path

import cv2
import numpy as np


DEFAULT_RT = "/home/ta/tkDNN/build/yolo4tiny_fp16.rt"
DEFAULT_TKDNN_BUILD = "/home/ta/tkDNN/build"
INPUT_SIZE = 416
NUM_CLASSES = 80
DEFAULT_MAX_DETECTIONS = 50
ANCHORS = [(10, 14), (23, 27), (37, 58), (81, 82), (135, 169), (344, 319)]
MASKS_BY_GRID = {
    13: [3, 4, 5],
    26: [1, 2, 3],
}


def parse_args():
    parser = argparse.ArgumentParser(description="Run tkDNN YOLOv4-tiny .rt inference and emit JSON detections.")
    parser.add_argument("--rt", default=os.environ.get("TKDNN_RT", DEFAULT_RT), help="Path to tkDNN .rt file.")
    parser.add_argument("--cfg", default="", help="Accepted for compatibility with the FastAPI adapter.")
    parser.add_argument("--weights", default="", help="Accepted for compatibility with the FastAPI adapter.")
    parser.add_argument("--names", required=True, help="Path to class names file.")
    parser.add_argument("--image", default="", help="Path to input image.")
    parser.add_argument("--conf", type=float, default=0.25, help="Confidence threshold.")
    parser.add_argument("--iou", type=float, default=0.45, help="NMS IoU threshold.")
    parser.add_argument("--max-detections", type=int, default=DEFAULT_MAX_DETECTIONS)
    parser.add_argument("--tkdnn-build", default=os.environ.get("TKDNN_BUILD", DEFAULT_TKDNN_BUILD))
    parser.add_argument(
        "--server",
        action="store_true",
        help="Keep TensorRT loaded and read JSON requests from stdin, one per line.",
    )
    return parser.parse_args()


def load_tkdnn_plugins(tkdnn_build):
    build_dir = Path(tkdnn_build)
    for lib_name in ("libkernels.so", "libtkDNN.so"):
        lib_path = build_dir / lib_name
        if lib_path.is_file():
            ctypes.CDLL(str(lib_path), mode=ctypes.RTLD_GLOBAL)


def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-x))


def yolo_activation(values):
    arr = np.asarray(values)
    finite = arr[np.isfinite(arr)]
    if finite.size and finite.min() >= -1e-4 and finite.max() <= 1.0001:
        return np.clip(arr, 0.0, 1.0)
    return sigmoid(arr)


def load_names(path):
    with open(path, "r", encoding="utf-8") as names_file:
        return [line.strip() for line in names_file if line.strip()]


def preprocess(image):
    resized = cv2.resize(image, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_LINEAR)
    rgb = cv2.cvtColor(resized, cv2.COLOR_BGR2RGB)
    nchw = rgb.astype(np.float32) / 255.0
    nchw = np.transpose(nchw, (2, 0, 1))[None, ...]
    return np.ascontiguousarray(nchw)


class TensorRTYoloRunner:
    def __init__(self, rt_path, input_shape=(1, 3, INPUT_SIZE, INPUT_SIZE)):
        import pycuda.autoinit  # noqa: F401
        import pycuda.driver as cuda
        import tensorrt as trt

        self.cuda = cuda
        self.trt = trt
        self.batch_size = int(input_shape[0])

        logger = trt.Logger(trt.Logger.ERROR)
        trt.init_libnvinfer_plugins(logger, "")
        with open(rt_path, "rb") as engine_file:
            engine_bytes = engine_file.read()

        self.runtime = trt.Runtime(logger)
        self.engine = self.runtime.deserialize_cuda_engine(engine_bytes)
        if self.engine is None:
            raise RuntimeError("Could not deserialize tkDNN .rt file: {}".format(rt_path))

        self.context = self.engine.create_execution_context()
        if self.context is None:
            raise RuntimeError("Could not create TensorRT execution context")

        self.implicit_batch = bool(getattr(self.engine, "has_implicit_batch_dimension", False))
        self.bindings = [0] * self.engine.num_bindings
        self.outputs = []
        self.input_device = None
        self.input_dtype = None
        self.input_nbytes = None

        self._allocate_bindings(input_shape)
        self.stream = cuda.Stream()

    def _binding_shape(self, idx):
        if hasattr(self.context, "get_binding_shape"):
            shape = self.context.get_binding_shape(idx)
        else:
            shape = self.engine.get_binding_shape(idx)
        return tuple(int(dim) for dim in shape)

    def _allocate_bindings(self, input_shape):
        for idx in range(self.engine.num_bindings):
            shape = tuple(int(dim) for dim in self.engine.get_binding_shape(idx))
            dtype = self.trt.nptype(self.engine.get_binding_dtype(idx))

            if self.engine.binding_is_input(idx):
                if not self.implicit_batch and any(dim < 0 for dim in shape):
                    self.context.set_binding_shape(idx, tuple(input_shape))
                    shape = self._binding_shape(idx)
                host = np.empty(input_shape, dtype=dtype)
                self.input_dtype = dtype
                self.input_nbytes = host.nbytes
                self.input_device = self.cuda.mem_alloc(host.nbytes)
                self.bindings[idx] = int(self.input_device)
                continue

            if any(dim < 0 for dim in shape):
                shape = self._binding_shape(idx)
            output_shape = (self.batch_size,) + shape if self.implicit_batch else shape
            size = int(np.prod(output_shape))
            host = self.cuda.pagelocked_empty(size, dtype)
            device = self.cuda.mem_alloc(host.nbytes)
            self.bindings[idx] = int(device)
            self.outputs.append((output_shape, host, device))

        if self.input_device is None:
            raise RuntimeError("TensorRT engine has no input binding")

    def infer(self, tensor):
        tensor = np.ascontiguousarray(tensor.astype(self.input_dtype, copy=False))
        if tensor.nbytes != self.input_nbytes:
            raise RuntimeError(
                "Unexpected input tensor size: got {} bytes, expected {}".format(
                    tensor.nbytes,
                    self.input_nbytes,
                )
            )

        self.cuda.memcpy_htod_async(self.input_device, tensor, self.stream)
        if self.implicit_batch:
            ok = self.context.execute_async(
                batch_size=int(tensor.shape[0]),
                bindings=self.bindings,
                stream_handle=self.stream.handle,
            )
        else:
            ok = self.context.execute_async_v2(bindings=self.bindings, stream_handle=self.stream.handle)
        if not ok:
            raise RuntimeError("TensorRT execution failed")

        for _, host, device in self.outputs:
            self.cuda.memcpy_dtoh_async(host, device, self.stream)
        self.stream.synchronize()

        tensors = []
        for shape, host, _ in self.outputs:
            tensors.append(np.array(host).reshape(shape))
        return tensors


def run_tensorrt(rt_path, tensor):
    return TensorRTYoloRunner(rt_path, input_shape=tensor.shape).infer(tensor)


def decode_yolov4_tiny(outputs, orig_w, orig_h, conf_thresh):
    decoded = []
    min_objectness = max(0.5, conf_thresh)

    for output in outputs:
        arr = np.asarray(output)
        arr = np.squeeze(arr)
        if arr.ndim != 3:
            continue

        channels, grid_h, grid_w = arr.shape
        if grid_h != grid_w or channels % 3 != 0:
            continue

        masks = MASKS_BY_GRID.get(grid_h)
        if masks is None:
            continue

        attrs = channels // 3
        classes = attrs - 5
        pred = arr.reshape(3, attrs, grid_h, grid_w)

        for anchor_slot, anchor_idx in enumerate(masks):
            anchor_w, anchor_h = ANCHORS[anchor_idx]
            values = pred[anchor_slot]

            tx = values[0]
            ty = values[1]
            tw = values[2]
            th = values[3]
            objectness = yolo_activation(values[4])
            class_scores = yolo_activation(values[5 : 5 + classes])

            best_class = np.argmax(class_scores, axis=0)
            best_score = np.max(class_scores, axis=0)
            confidence = objectness * best_score
            ys, xs = np.where((confidence > conf_thresh) & (objectness > min_objectness))

            tx_act = yolo_activation(tx)
            ty_act = yolo_activation(ty)

            for y, x in zip(ys, xs):
                conf = float(confidence[y, x])
                cls = int(best_class[y, x])
                bx = (float(tx_act[y, x]) + x) / grid_w * INPUT_SIZE
                by = (float(ty_act[y, x]) + y) / grid_h * INPUT_SIZE
                bw = math.exp(float(np.clip(tw[y, x], -10.0, 10.0))) * anchor_w
                bh = math.exp(float(np.clip(th[y, x], -10.0, 10.0))) * anchor_h

                x1 = (bx - bw / 2.0) * orig_w / INPUT_SIZE
                y1 = (by - bh / 2.0) * orig_h / INPUT_SIZE
                x2 = (bx + bw / 2.0) * orig_w / INPUT_SIZE
                y2 = (by + bh / 2.0) * orig_h / INPUT_SIZE
                decoded.append((cls, conf, [x1, y1, x2, y2]))

    return decoded


def nms(detections, iou_thresh):
    if not detections:
        return []

    kept = []
    classes = sorted({class_id for class_id, _, _ in detections})

    for class_id in classes:
        class_detections = [d for d in detections if d[0] == class_id]
        order = np.argsort([d[1] for d in class_detections])[::-1]

        while len(order) > 0:
            current = int(order[0])
            kept.append(class_detections[current])
            if len(order) == 1:
                break

            current_box = np.array(class_detections[current][2], dtype=np.float32)
            remaining = [class_detections[int(i)] for i in order[1:]]
            remaining_boxes = np.array([d[2] for d in remaining], dtype=np.float32)

            xx1 = np.maximum(current_box[0], remaining_boxes[:, 0])
            yy1 = np.maximum(current_box[1], remaining_boxes[:, 1])
            xx2 = np.minimum(current_box[2], remaining_boxes[:, 2])
            yy2 = np.minimum(current_box[3], remaining_boxes[:, 3])

            inter_w = np.maximum(0.0, xx2 - xx1)
            inter_h = np.maximum(0.0, yy2 - yy1)
            intersection = inter_w * inter_h

            current_area = max(0.0, current_box[2] - current_box[0]) * max(0.0, current_box[3] - current_box[1])
            remaining_area = np.maximum(0.0, remaining_boxes[:, 2] - remaining_boxes[:, 0]) * np.maximum(
                0.0, remaining_boxes[:, 3] - remaining_boxes[:, 1]
            )
            union = current_area + remaining_area - intersection
            iou = intersection / np.maximum(union, 1e-6)
            order = order[1:][iou <= iou_thresh]

    return kept


def infer_image(runner, names, image_path, conf_thresh, iou_thresh, max_detections=DEFAULT_MAX_DETECTIONS):
    image = cv2.imread(image_path)
    if image is None:
        raise RuntimeError("Could not read image: {}".format(image_path))

    tensor = preprocess(image)
    outputs = runner.infer(tensor)
    detections = nms(decode_yolov4_tiny(outputs, image.shape[1], image.shape[0], conf_thresh), iou_thresh)
    detections = sorted(detections, key=lambda item: item[1], reverse=True)[:max_detections]

    payload = []
    for class_id, confidence, bbox in detections:
        class_name = names[class_id] if 0 <= class_id < len(names) else str(class_id)
        x1, y1, x2, y2 = bbox
        payload.append(
            {
                "class_id": class_id,
                "class_name": class_name,
                "confidence": round(float(confidence), 4),
                "bbox_xyxy": [
                    round(max(0.0, min(float(x1), image.shape[1] - 1)), 1),
                    round(max(0.0, min(float(y1), image.shape[0] - 1)), 1),
                    round(max(0.0, min(float(x2), image.shape[1] - 1)), 1),
                    round(max(0.0, min(float(y2), image.shape[0] - 1)), 1),
                ],
            }
        )
    return payload


def serve_requests(runner, names, default_conf, default_iou, default_max_detections):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue

        try:
            request = json.loads(line)
            image_path = request.get("image", "")
            if not image_path:
                raise RuntimeError("Request missing image path")

            conf_thresh = float(request.get("conf", default_conf))
            iou_thresh = float(request.get("iou", default_iou))
            max_detections = int(request.get("max_detections", default_max_detections))
            detections = infer_image(runner, names, image_path, conf_thresh, iou_thresh, max_detections)
            response = {"ok": True, "detections": detections}
        except Exception as exc:
            response = {"ok": False, "error": str(exc)}

        print(json.dumps(response, separators=(",", ":")), flush=True)


def main():
    args = parse_args()
    rt_path = Path(args.rt)
    if not rt_path.is_file():
        raise RuntimeError("tkDNN .rt file does not exist: {}".format(rt_path))

    if not args.server and not args.image:
        raise RuntimeError("--image is required unless --server is used")

    names = load_names(args.names)
    load_tkdnn_plugins(args.tkdnn_build)
    runner = TensorRTYoloRunner(str(rt_path))

    if args.server:
        print("tkdnn_json_infer server ready", file=sys.stderr, flush=True)
        serve_requests(runner, names, args.conf, args.iou, args.max_detections)
        return

    payload = infer_image(runner, names, args.image, args.conf, args.iou, args.max_detections)
    print(json.dumps(payload, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
